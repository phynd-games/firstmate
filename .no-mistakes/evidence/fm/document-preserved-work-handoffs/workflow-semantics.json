        {
          "name": "Canonical instruction sources",
          "run": "bin/fm-instruction-sources-check.sh"
        },
        {
          "name": "Personal fleet paths must not be tracked",
          "run": "set -eu\ntracked=$(git ls-files -- data state projects .no-mistakes)\nif [ -n \"$tracked\" ]; then\n  echo \"::error::Personal fleet data paths are tracked in git:\"\n  printf '%s\\n' \"$tracked\"\n  exit 1\nfi\nunexpected_config=$(git ls-files -- config | grep -Ev '^(config/backend|config/crew-dispatch\\.json|config/fresh/config\\.json|config/herdr-presentation-spaces|config/starship\\.toml)$' || true)\nif [ -n \"$unexpected_config\" ]; then\n  echo \"::error::Unapproved local config paths are tracked in git:\"\n  printf '%s\\n' \"$unexpected_config\"\n  exit 1\nfi\n"
        }
      ]
    }
  },
