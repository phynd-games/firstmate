#!/usr/bin/env bash
# phynd-dev - reconcile the pinned macOS Firstmate developer environment.
# Usage: phynd-dev [install|update|switch|flake-update|flake-check|tools|install-tool|launch|status]
#
# install (default) bootstraps Determinate Nix when necessary, applies the
# pinned nix-darwin and Home Manager configuration, installs the npm tools used
# by Firstmate, and links repository-owned editor configuration safely.
# update repeats that reconciliation after repository configuration changes.
# switch is the activation-only form; flake-update is the explicit lock-file
# update operation; flake-check evaluates the flake without building it.
# tools and install-tool reconcile one named tool; launch opens Herdr when run
# from an interactive terminal; status is read-only.
set -euo pipefail

say() {
  printf 'phynd-dev: %s\n' "$*"
}

die() {
  printf 'phynd-dev: error: %s\n' "$*" >&2
  exit 1
}

script_root() {
  local source=${BASH_SOURCE[0]} source_dir target hops=0 root
  while [ -L "$source" ]; do
    hops=$((hops + 1))
    [ "$hops" -le 40 ] || die 'cannot resolve the repository root: symlink chain is too deep'
    source_dir=$(CDPATH='' cd -- "$(dirname -- "$source")" && pwd -P) \
      || die 'cannot resolve the repository root'
    target=$(readlink "$source") \
      || die 'cannot resolve the repository root'
    case "$target" in
      /*) source=$target ;;
      *) source="$source_dir/$target" ;;
    esac
  done
  root=$(CDPATH='' cd -- "$(dirname -- "$source")/.." && pwd -P) \
    || die 'cannot resolve the repository root'
  [ -f "$root/flake.nix" ] \
    || die "repository root '$root' has no flake.nix"
  printf '%s\n' "$root"
}

host_system() {
  case "${PHYN_DEV_UNAME_S:-$(uname -s)}-${PHYN_DEV_UNAME_M:-$(uname -m)}" in
    Darwin-arm64) printf 'aarch64-darwin\n' ;;
    Darwin-x86_64) printf 'x86_64-darwin\n' ;;
    *) die 'phynd-dev supports macOS on Apple Silicon or Intel only' ;;
  esac
}

configure_paths() {
  DEV_ROOT=$1
  DEV_HOME=${PHYN_DEV_HOME:-${HOME:?HOME is required}}
  DEV_SYSTEM=$(host_system)
  DEV_XDG_CONFIG_HOME=${PHYN_DEV_XDG_CONFIG_HOME:-${XDG_CONFIG_HOME:-$DEV_HOME/.config}}
  DEV_STATE_DIR=${PHYN_DEV_STATE_DIR:-$DEV_HOME/.local/state/phynd-dev}
  DEV_NPM_PREFIX=${PHYN_DEV_NPM_PREFIX:-$DEV_HOME/.local/share/phynd-dev/npm}
  DEV_NIX_PROFILE=${PHYN_DEV_NIX_PROFILE:-$DEV_HOME/.nix-profile/bin}
  DEV_ACTIVATION_STATE=$DEV_STATE_DIR/activation.sha256
  export PHYN_DEV_ROOT="$DEV_ROOT"
  export PHYN_DEV_USER="${PHYN_DEV_USER:-$(id -un)}"
  export PHYN_DEV_HOME="$DEV_HOME"
  export PHYN_DEV_SYSTEM="$DEV_SYSTEM"
  export NPM_CONFIG_PREFIX="$DEV_NPM_PREFIX"
}

refresh_path() {
  local per_user_profile current_system
  per_user_profile="/etc/profiles/per-user/$PHYN_DEV_USER/bin"
  current_system=/run/current-system/sw/bin
  PATH="$DEV_NPM_PREFIX/bin:$DEV_HOME/.local/bin:$DEV_NIX_PROFILE:$per_user_profile:$current_system:$PATH"
  export PATH
}

load_nix() {
  local profile
  command -v nix >/dev/null 2>&1 && return 0
  for profile in \
    "${PHYN_DEV_NIX_BIN:-}" \
    "$DEV_NIX_PROFILE/nix" \
    "$DEV_HOME/.local/state/nix/profiles/profile/bin/nix" \
    /nix/var/nix/profiles/default/bin/nix; do
    [ -n "$profile" ] || continue
    if [ -x "$profile" ]; then
      PATH="$(dirname "$profile"):$PATH"
      export PATH
      command -v nix >/dev/null 2>&1 && return 0
    fi
  done
  if [ -r /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh ]; then
    # shellcheck source=/dev/null
    . /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh
  fi
  command -v nix >/dev/null 2>&1
}

bootstrap_nix() {
  if load_nix; then
    say 'Determinate Nix is available'
    return 0
  fi
  command -v curl >/dev/null 2>&1 \
    || die 'curl is required to bootstrap Determinate Nix'
  say 'bootstrapping Determinate Nix'
  curl --proto '=https' --tlsv1.2 -fsSL \
    https://install.determinate.systems/nix \
    | /bin/sh -s -- install --no-confirm
  load_nix \
    || die 'Nix installation completed but nix is not available; open a new shell and rerun phynd-dev'
}

hash_command() {
  if command -v shasum >/dev/null 2>&1; then
    printf 'shasum\n'
  elif command -v sha256sum >/dev/null 2>&1; then
    printf 'sha256sum\n'
  else
    die 'shasum or sha256sum is required to track activation state'
  fi
}

desired_hash() {
  local hash_tool file
  hash_tool=$(hash_command)
  {
    for file in \
      flake.nix \
      flake.lock \
      nix/configuration.nix \
      nix/home.nix \
      config/fresh/config.json \
      config/starship.toml \
      home/wezterm/wezterm.lua \
      bin/phynd-dev; do
      [ -f "$DEV_ROOT/$file" ] || die "managed file is missing: $file"
      printf '%s  ' "$file"
      "$hash_tool" -a 256 "$DEV_ROOT/$file" 2>/dev/null \
        | awk '{print $1}'
    done
  } | "$hash_tool" -a 256 | awk '{print $1}'
}

run_privileged() {
  if [ "${PHYN_DEV_SKIP_SUDO:-0}" = 1 ] || [ "$(id -u)" -eq 0 ]; then
    "$@"
  elif command -v sudo >/dev/null 2>&1; then
    sudo "$@"
  else
    die 'sudo is required for nix-darwin activation'
  fi
}

activation_command() {
  local rebuild
  if command -v darwin-rebuild >/dev/null 2>&1; then
    rebuild=$(command -v darwin-rebuild)
    run_privileged env \
      "PHYN_DEV_USER=$PHYN_DEV_USER" \
      "PHYN_DEV_HOME=$PHYN_DEV_HOME" \
      "PHYN_DEV_SYSTEM=$PHYN_DEV_SYSTEM" \
      "PHYN_DEV_ROOT=$DEV_ROOT" \
      "$rebuild" switch --flake "$DEV_ROOT#phynd-dev" --impure
  else
    run_privileged env \
      "PHYN_DEV_USER=$PHYN_DEV_USER" \
      "PHYN_DEV_HOME=$PHYN_DEV_HOME" \
      "PHYN_DEV_SYSTEM=$PHYN_DEV_SYSTEM" \
      "PHYN_DEV_ROOT=$DEV_ROOT" \
      nix run "$DEV_ROOT#darwin-rebuild" -- \
      switch --flake "$DEV_ROOT#phynd-dev" --impure
  fi
}

managed_link_converged() {
  local target=$1 source=$2
  [ -L "$target" ] \
    && [ "$(readlink "$target" 2>/dev/null || true)" = "$source" ]
}

managed_activation_converged() {
  local tool
  for tool in \
    actionlint basedpyright basedpyright-langserver fd fresh fzf gh git jq \
    lua-language-server node npm npx rg rust-analyzer shellcheck starship \
    treehouse typescript-language-server tmux curl; do
    command -v "$tool" >/dev/null 2>&1 || return 1
  done
  managed_link_converged "$DEV_HOME/.config/fresh/config.json" \
    "$DEV_ROOT/config/fresh/config.json" || return 1
  managed_link_converged "$DEV_HOME/.config/wezterm/wezterm.lua" \
    "$DEV_ROOT/home/wezterm/wezterm.lua" || return 1
  managed_link_converged "$DEV_HOME/.local/bin/phynd-dev" \
    "$DEV_ROOT/bin/phynd-dev"
}

activate() {
  local hash current
  PHYN_DEV_ACTIVATION_CHANGED=0
  export PHYN_DEV_ACTIVATION_CHANGED
  hash=$(desired_hash)
  current=
  if [ -f "$DEV_ACTIVATION_STATE" ]; then
    current=$(sed -n '1p' "$DEV_ACTIVATION_STATE")
  fi
  if [ "$current" = "$hash" ] && managed_activation_converged; then
    say 'nix-darwin and Home Manager are already converged'
    return 0
  fi
  if [ "${PHYN_DEV_SKIP_ACTIVATION:-0}" = 1 ]; then
    say 'activation skipped by test harness'
  elif [ "${PHYN_DEV_DRY_RUN:-0}" = 1 ]; then
    say "would apply nix-darwin and Home Manager from $DEV_ROOT"
  else
    say 'applying pinned nix-darwin and Home Manager configuration'
    activation_command
  fi
  mkdir -p "$DEV_STATE_DIR"
  printf '%s\n' "$hash" > "$DEV_ACTIVATION_STATE"
  PHYN_DEV_ACTIVATION_CHANGED=1
  export PHYN_DEV_ACTIVATION_CHANGED
  say 'activation state recorded'
  return 0
}

backup_target() {
  local target=$1 suffix candidate number
  suffix=${PHYN_DEV_BACKUP_SUFFIX:-$(date +%Y%m%d%H%M%S)}
  candidate="$target.phynd-dev-backup-$suffix"
  number=1
  while [ -e "$candidate" ] || [ -L "$candidate" ]; do
    candidate="$target.phynd-dev-backup-$suffix-$number"
    number=$((number + 1))
  done
  printf '%s\n' "$candidate"
}

link_repo_file() {
  local source=$1 target=$2 current backup
  [ -f "$source" ] || die "managed source is missing: $source"
  mkdir -p "$(dirname "$target")"
  if [ -L "$target" ]; then
    current=$(readlink "$target" 2>/dev/null || true)
    [ "$current" = "$source" ] && return 0
    backup=$(backup_target "$target")
    mv "$target" "$backup"
    say "moved existing link $target to $backup"
  elif [ -e "$target" ]; then
    backup=$(backup_target "$target")
    mv "$target" "$backup"
    say "backed up existing $target to $backup"
  fi
  ln -s "$source" "$target"
  say "linked $target to repository configuration"
}

reconcile_repo_links() {
  link_repo_file "$DEV_ROOT/home/wezterm/wezterm.lua" \
    "$DEV_XDG_CONFIG_HOME/wezterm/wezterm.lua"
  link_repo_file "$DEV_ROOT/config/fresh/config.json" \
    "$DEV_XDG_CONFIG_HOME/fresh/config.json"
}

npm_tool_spec() {
  case "$1" in
    pi) printf '@earendil-works/pi-coding-agent\n' ;;
    gnhf|ghf) printf 'gnhf\n' ;;
    gh-axi|chrome-devtools-axi|lavish-axi|tasks-axi|quota-axi) printf '%s\n' "$1" ;;
    *) return 1 ;;
  esac
}

install_npm_tool() {
  local name=$1 spec
  spec=$(npm_tool_spec "$name") || die "unknown npm-managed tool: $name"
  command -v npm >/dev/null 2>&1 \
    || die 'npm is not on PATH after activation; open a new shell and rerun phynd-dev'
  mkdir -p "$DEV_NPM_PREFIX" "$DEV_HOME/.local/bin"
  say "reconciling $name through npm"
  npm install --global --prefix "$DEV_NPM_PREFIX" "$spec"
  if [ "$name" = gnhf ] || [ "$name" = ghf ]; then
    ln -sfn "$DEV_NPM_PREFIX/bin/gnhf" "$DEV_HOME/.local/bin/ghf"
  fi
}

install_no_mistakes() {
  if command -v no-mistakes >/dev/null 2>&1; then
    say 'no-mistakes is already available'
    return 0
  fi
  command -v curl >/dev/null 2>&1 \
    || die 'curl is required to install no-mistakes'
  say 'installing no-mistakes with its official installer'
  curl -fsSL \
    https://raw.githubusercontent.com/kunchenguid/no-mistakes/main/docs/install.sh \
    | /bin/sh
}

install_nix_tool() {
  activate >/dev/null
}

install_tool() {
  local tool=$1
  if npm_tool_spec "$tool" >/dev/null 2>&1; then
    install_npm_tool "$tool"
    return 0
  fi
  case "$tool" in
    no-mistakes) install_no_mistakes ;;
    herdr)
      command -v brew >/dev/null 2>&1 || die 'Homebrew is unavailable; rerun phynd-dev switch first'
      brew install herdr
      ;;
    wezterm)
      command -v brew >/dev/null 2>&1 || die 'Homebrew is unavailable; rerun phynd-dev switch first'
      brew install --cask wezterm
      ;;
    opensuperwhisper)
      command -v brew >/dev/null 2>&1 || die 'Homebrew is unavailable; rerun phynd-dev switch first'
      brew install --cask opensuperwhisper
      ;;
    node|fresh|starship|rust-analyzer|lua-language-server|basedpyright|typescript-language-server|\
    treehouse|git|gh|curl|jq|tmux|shellcheck|actionlint)
      install_nix_tool
      ;;
    *) die "unknown managed tool: $tool" ;;
  esac
}

install_firstmate_tools() {
  local tool
  for tool in pi gnhf gh-axi chrome-devtools-axi lavish-axi tasks-axi quota-axi; do
    install_npm_tool "$tool"
  done
  install_no_mistakes
  for tool in gh-axi chrome-devtools-axi lavish-axi; do
    if [ -x "$DEV_NPM_PREFIX/bin/$tool" ]; then
      "$DEV_NPM_PREFIX/bin/$tool" setup hooks
    fi
  done
}

launch() {
  command -v herdr >/dev/null 2>&1 \
    || die 'Herdr is unavailable; run phynd-dev install or phynd-dev install-tool herdr'
  command -v pi >/dev/null 2>&1 \
    || die 'Pi is unavailable; run phynd-dev install or phynd-dev install-tool pi'
  say 'Herdr and Pi are ready; launch Herdr here and start Pi in its terminal'
  if [ "${PHYN_DEV_NO_ATTACH:-0}" != 1 ] && [ -t 0 ] && [ -t 1 ]; then
    exec herdr
  fi
}

status() {
  local tool
  printf 'checkout: %s\n' "$DEV_ROOT"
  printf 'system:   %s\n' "$DEV_SYSTEM"
  printf 'fresh-config: %s\n' "$DEV_XDG_CONFIG_HOME/fresh/config.json"
  printf 'wezterm-config: %s\n' "$DEV_XDG_CONFIG_HOME/wezterm/wezterm.lua"
  for tool in nix darwin-rebuild brew wezterm herdr fresh starship \
    rust-analyzer lua-language-server basedpyright-langserver \
    typescript-language-server pi gh-axi lavish-axi tasks-axi quota-axi no-mistakes; do
    if command -v "$tool" >/dev/null 2>&1; then
      printf '%-28s %s\n' "$tool" "$(command -v "$tool")"
    else
      printf '%-28s missing\n' "$tool"
    fi
  done
}

flake_update() {
  ensure_nix
  say 'updating the flake lock file explicitly'
  nix flake update --flake "$DEV_ROOT"
  say 'flake inputs changed; run phynd-dev update to activate them'
}

flake_check() {
  ensure_nix
  say 'evaluating the pinned flake without building system closures'
  nix flake check --no-build --impure "$DEV_ROOT"
}

ensure_nix() {
  bootstrap_nix
  refresh_path
}

reconcile() {
  ensure_nix
  activate
  refresh_path
  if [ "${PHYN_DEV_SKIP_TOOLS:-0}" != 1 ] && {
    [ "${PHYN_DEV_ACTIVATION_CHANGED:-0}" = 1 ] ||
    ! command -v no-mistakes >/dev/null 2>&1 ||
    ! command -v pi >/dev/null 2>&1 ||
    ! command -v gnhf >/dev/null 2>&1 ||
    ! command -v gh-axi >/dev/null 2>&1 ||
    ! command -v chrome-devtools-axi >/dev/null 2>&1 ||
    ! command -v lavish-axi >/dev/null 2>&1 ||
    ! command -v tasks-axi >/dev/null 2>&1 ||
    ! command -v quota-axi >/dev/null 2>&1
  }; then
    install_firstmate_tools
  fi
  reconcile_repo_links
  if [ "${PHYN_DEV_ACTIVATION_CHANGED:-0}" = 1 ]; then
    say 'environment is converged'
  fi
}

usage() {
  sed -n '2,14p' "$0" | sed 's/^# //'
}

main() {
  local command root
  command=${1:-install}
  shift || true
  root=$(script_root)
  configure_paths "$root"
  refresh_path
  case "$command" in
    install|update) reconcile ;;
    switch)
      ensure_nix
      activate
      refresh_path
      reconcile_repo_links
      ;;
    flake-update) flake_update ;;
    flake-check) flake_check ;;
    tools|install-tool)
      [ "$#" -gt 0 ] || die 'usage: phynd-dev install-tool <tool>...'
      ensure_nix
      while [ "$#" -gt 0 ]; do
        install_tool "$1"
        shift
      done
      reconcile_repo_links
      ;;
    launch) launch ;;
    status) status ;;
    -h|--help|help) usage ;;
    *) die "usage: phynd-dev [install|update|switch|flake-update|flake-check|tools|install-tool|launch|status]" ;;
  esac
}

main "$@"
