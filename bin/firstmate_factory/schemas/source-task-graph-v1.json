{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "phynd-firstmate-m1-task-graph.v1",
  "title": "Imported Phynd Firstmate M1 source task graph",
  "description": "Preserved offline planning material. Validation does not import backlog work, authorize execution, or verify artifact origin.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "title", "generated", "task_count", "epics", "tasks"],
  "properties": {
    "schema": {"const": "phynd-firstmate-m1-task-graph.v1"},
    "title": {"type": "string", "minLength": 1},
    "generated": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "task_count": {"type": "integer", "minimum": 1},
    "epics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "goal", "phase", "tasks"],
        "properties": {
          "id": {"type": "string", "pattern": "^E[0-9]+$"},
          "title": {"type": "string", "minLength": 1},
          "goal": {"type": "string", "minLength": 1},
          "phase": {"type": "string", "minLength": 1},
          "tasks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "array",
              "minItems": 7,
              "maxItems": 7,
              "prefixItems": [
                {"type": "string", "pattern": "^E[0-9]+\\.[0-9]{2}$"},
                {"type": "string", "minLength": 1},
                {"type": "string", "minLength": 1},
                {"type": "string", "minLength": 1},
                {"type": "string", "minLength": 1},
                {"type": "array", "items": {"type": "string", "pattern": "^E[0-9]+\\.[0-9]{2}$"}, "uniqueItems": true},
                {"type": "string", "minLength": 1}
              ]
            }
          }
        }
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "epic", "epic_title", "phase", "title", "detail", "output", "acceptance", "dependencies", "owner"],
        "properties": {
          "id": {"type": "string", "pattern": "^E[0-9]+\\.[0-9]{2}$"},
          "epic": {"type": "string", "pattern": "^E[0-9]+$"},
          "epic_title": {"type": "string", "minLength": 1},
          "phase": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "detail": {"type": "string", "minLength": 1},
          "output": {"type": "string", "minLength": 1},
          "acceptance": {"type": "string", "minLength": 1},
          "dependencies": {"type": "array", "items": {"type": "string", "pattern": "^E[0-9]+\\.[0-9]{2}$"}, "uniqueItems": true},
          "owner": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
