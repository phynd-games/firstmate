{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "firstmate.m1-execution-manifest.v1",
  "title": "Firstmate M1 normalized execution manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "manifest_id", "validator", "source", "plan", "authority", "tasks", "acceptance_tasks", "gates", "not_in_m1", "manifest_hash"],
  "properties": {
    "schema": {"const": "firstmate.m1-execution-manifest.v1"},
    "manifest_id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
    "validator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"const": "firstmate_factory"},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}
      }
    },
    "source": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "schema"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "schema": {"type": "string", "minLength": 1}
        }
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_sha256", "repo_commit"],
      "properties": {
        "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "repo_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "approval_id", "scope"],
      "properties": {
        "state": {"enum": ["draft", "captain_approved", "active", "quiescing", "complete", "rolled_back"]},
        "approval_id": {"type": ["string", "null"]},
        "scope": {"type": "array", "items": {"type": "string", "pattern": "^M[0-9]+-[0-9]{3}$"}, "uniqueItems": true}
      }
    },
    "tasks": {"type": "array", "minItems": 1, "items": {"$ref": "execution-task-v1.json"}},
    "acceptance_tasks": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^M[0-9]+-[0-9]{3}$"}, "uniqueItems": true},
    "gates": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "not_in_m1": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "manifest_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
