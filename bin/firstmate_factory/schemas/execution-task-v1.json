{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "firstmate.execution-task.v1",
  "title": "Firstmate normalized execution task",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "title", "kind", "dependencies", "route_request", "delivery", "artifacts", "acceptance", "rollback", "source_refs"],
  "properties": {
    "schema": {"const": "firstmate.execution-task.v1"},
    "id": {"type": "string", "pattern": "^M[0-9]+-[0-9]{3}$"},
    "title": {"type": "string", "minLength": 1},
    "kind": {"enum": ["ship", "scout", "captain-gate"]},
    "dependencies": {"type": "array", "items": {"type": "string", "pattern": "^M[0-9]+-[0-9]{3}$"}, "uniqueItems": true},
    "route_request": {"$ref": "route-request-v1.json"},
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "yolo"],
      "properties": {
        "mode": {"enum": ["no-mistakes", "direct-PR", "local-only"]},
        "yolo": {"type": "boolean"}
      }
    },
    "artifacts": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "acceptance": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
    "rollback": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^E[0-9]+\\.[0-9]{2}$"}, "uniqueItems": true}
  }
}
